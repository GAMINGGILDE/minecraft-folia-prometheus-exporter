    "dynamic_latest": false,
    "activation_marker": "FoliaPrometheusExporter started.",
    "verifies_http_endpoints": true,
    "verifies_embedded_git_commit": true,
    "verifies_phase_3_metrics": true,
    "verifies_phase_7_entity_metrics": true,
    "verifies_http_shutdown": true,
    "paper": {
      "version": "26.1.2",
      "build": 74,
      "sha256": "1d70b1dab9cf4a6de615209a536f3a45a2186240253c428213ce2188ab95e5f7"
    },
