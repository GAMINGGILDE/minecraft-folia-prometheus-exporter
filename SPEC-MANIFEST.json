      "prometheus-metrics-core",
      "prometheus-metrics-instrumentation-jvm",
      "prometheus-metrics-exporter-httpserver"
    ],
    "http_server": "official Prometheus MetricsHandler on the exporter module's JDK HttpServer",
    "additional_http_framework": false,
    "custom_prometheus_text_renderer": false,
    "default_bind_address": "127.0.0.1",
    "http_host_port_paths_and_workers_from_configuration": true,
    "endpoints": [
      "/metrics",
      "/health",
      "/ready"
    ],
    "snapshot_only_http_reads": true,
    "build_git_commit_source": "git rev-parse HEAD",
    "build_git_commit_resource": "build-info.properties",
    "build_git_commit_fallback": "unknown",
    "build_git_commit_override_property": "gitCommit",
    "exporter_metrics_scope": "one instance per MetricsCore private registry",
    "static_exporter_metrics_cache": false,
    "prometheus_relocation": "de.minecraftgilde.prometheus.internal.prometheus",
    "shadow_plugin": "com.gradleup.shadow:9.6.1",
    "single_distributable_jar_verified": true,
    "collector_states": [
      "disabled",
      "starting",
      "running",
      "unsupported",
      "failed",
      "stopped"
    ],
    "collector_start_order": "registration order",
    "collector_stop_order": "reverse registration order for started collectors",
    "collector_failures_isolated": true,
    "snapshot_publication": "AtomicReference",
    "readiness_requires": [
      "registry",
      "metrics core",
      "HTTP server",
      "completed plugin initialization"
    ],
    "http_unknown_path_status": 404,
    "http_unsupported_method_status": 405,
    "exporter_metrics": [
      "minecraft_exporter_build_info",
      "minecraft_exporter_health",
      "minecraft_exporter_ready",
      "minecraft_exporter_scrapes_total",
      "minecraft_exporter_scrape_errors_total",
      "minecraft_exporter_http_requests_total",
      "minecraft_exporter_collector_state"
    ],
    "jvm_metrics_registered": false,
    "process_metrics_registered": false
  },
  "phase_3_architecture": {
    "implemented": true,
    "registrar": "de.minecraftgilde.prometheus.jvm.JvmMetricsRegistrar",
    "registry_scope": "one private PrometheusRegistry per MetricsCore",
    "uses_default_registry": false,
    "uses_static_registry_state": false,
    "registration_idempotent_per_registrar": true,
    "registration_completed_before_readiness": true,
    "jvm_enabled_by_default": true,
    "process_enabled_by_default": true,
    "configuration_keys": [
      "collectors.jvm",
      "collectors.process"
    ],
    "official_instrumentations": [
      "JvmMemoryMetrics",
      "JvmGarbageCollectorMetrics",
      "JvmThreadsMetrics",
      "JvmClassLoadingMetrics",
      "JvmBufferPoolMetrics",
      "ProcessMetrics"
    ],
    "minecraft_live_objects_read": false,
    "scheduler_required": false,
    "snapshot_required": false,
    "background_threads_started": false,
    "platform_dependent_metrics": [
      "process_cpu_seconds_total",
      "process_open_fds",
      "process_max_fds",
      "process_virtual_memory_bytes",
      "process_resident_memory_bytes"
    ],
    "unavailable_in_client_1_8_0": [
      "process_cpu_usage_ratio",
      "process_uptime_seconds",
      "system_cpu_usage_ratio",
      "system_cpu_count",
      "system_load_average_1m"
    ],
    "next_phase": "Phase 4 Server and Worlds"
  },
  "phase_7_architecture": {
    "implemented": true,
    "enabled_by_default": true,
    "fixed_groups": [
      "monster",
