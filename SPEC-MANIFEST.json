    "default_reconciliation_timeout": "60s",
    "exact_types_enabled_by_default": false,
    "projectile_total_enabled_by_default": false,
    "snapshot_only_http_reads": true,
    "run_local_identity_only": true,
    "lifecycle_counters_implemented": false,
    "documentation_and_release_preparation_complete": true
  },
  "phase_6_folia_provider": {
    "phase": 6,
